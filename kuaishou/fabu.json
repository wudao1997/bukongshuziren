  if (!hit) return { ok: false, message: "no publish button" };
  const btn = hit.closest("button,[role=button],div,span") || hit;
  try { btn.scrollIntoView({ block: "center", inline: "center" }); } catch {}
  try { btn.click(); } catch {}
  return { ok: true };
})()
        `.trim()
      );
      clicked = r?.ok === true;
