    const publishSel =
      "#joyride-wrapper > main > div._edit-container_ql0z6_7 > div._edit-section_ql0z6_20._last_ql0z6_26 > div._edit-section-form_ql0z6_100 > div._edit-section-btns_ql0z6_118 > div._button_3a3lq_1._button-primary_3a3lq_60";

    throwIfCancelled();
    step("ks:publish:wait_btn");
    await waitSelector?.(publishSel, 20000, ctxId).catch(() => false);

    throwIfCancelled();
    step("ks:publish:click_btn");
    let clicked = false;
    if (typeof clickSelectorPoint === "function") clicked = !!(await clickSelectorPoint(publishSel, 48, 18));
    if (!clicked) {
      const r = await evalJs?.(
        `
(() => {
  const isVisible = (n) => {
    try {
      if (!n) return false;
      const r = n.getBoundingClientRect ? n.getBoundingClientRect() : null;
      if (!r) return true;
      return (r.width || 0) > 8 && (r.height || 0) > 8;
    } catch { return true; }
  };
  const textOf = (n) => String(n?.innerText || n?.textContent || "").replace(/\\s+/g, "");
  const nodes = Array.from(document.querySelectorAll("button,[role=button],div,span")).filter(isVisible);
